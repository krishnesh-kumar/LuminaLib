# Template for the PRODUCTION .env file.
# Create this file directly on the VPS (e.g. /home/deploy/luminalib/.env).
# It is never committed to git and CI never copies it there — only you set it,
# once, by hand (or via your own secrets-management tooling).

APP_NAME=LuminaLib
APP_ENV=production
API_PREFIX=/api
LOG_LEVEL=INFO

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=7

# POSTGRES_PASSWORD is read by docker-compose.prod.yml to set the db
# container's own root password (compose auto-loads this file for ${VAR}
# substitution because it's literally named .env). It must match the
# password you put in DATABASE_URL below -- compose does NOT expand ${...}
# inside env_file values, so the two have to be kept in sync by hand.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+psycopg2://postgres:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/luminalib

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
STORAGE_BUCKET=luminalib
MAX_UPLOAD_MB=25

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

RECS_PROVIDER=ml_als
